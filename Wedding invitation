    <script>
        // Global variables for safe Audio management
        let audioPlayPromise = null;

        // Initialize AOS Animation & Query Params
        document.addEventListener('DOMContentLoaded', function() {
            AOS.init({
                duration: 800,
                once: true,
                easing: 'ease-in-out'
            });

            // Parse URL Query Params for Guest Name (e.g. ?to=Nama+Tamu)
            const urlParams = new URLSearchParams(window.location.search);
            const guest = urlParams.get('to') || urlParams.get('nama');
            if (guest) {
                document.getElementById('guest-name').innerText = guest;
                document.getElementById('guest-input-name').value = guest;
            }

            // Start Countdown Timer
            startCountdown();
        });

        // Open Invitation Event Handler safely handling Audio promise
        function openInvitation() {
            const welcomeScreen = document.getElementById('welcome-screen');
            const mainContent = document.getElementById('main-content');
            const bgMusic = document.getElementById('bg-music');
            const musicIcon = document.getElementById('music-icon');

            // Fade out welcome screen smoothly
            welcomeScreen.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                welcomeScreen.style.display = 'none';
                mainContent.classList.remove('opacity-0');
            }, 1000);

            // Safe play request handling to prevent AbortError
            if (bgMusic.paused) {
                audioPlayPromise = bgMusic.play();
                if (audioPlayPromise !== undefined) {
                    audioPlayPromise.then(() => {
                        musicIcon.classList.add('rotating');
                    }).catch(err => {
                        console.log("Audio play request interrupted or blocked:", err);
                        musicIcon.classList.remove('rotating');
                    });
                }
            }
        }

        // Toggle Audio Play / Pause safely
        function toggleAudio() {
            const bgMusic = document.getElementById('bg-music');
            const musicIcon = document.getElementById('music-icon');

            if (bgMusic.paused) {
                audioPlayPromise = bgMusic.play();
                if (audioPlayPromise !== undefined) {
                    audioPlayPromise.then(() => {
                        musicIcon.classList.add('rotating');
                    }).catch(err => {
                        console.log("Audio play request error:", err);
                        musicIcon.classList.remove('rotating');
                    });
                }
            } else {
                if (audioPlayPromise !== undefined) {
                    audioPlayPromise.then(() => {
                        bgMusic.pause();
                        musicIcon.classList.remove('rotating');
                    }).catch(() => {
                        bgMusic.pause();
                        musicIcon.classList.remove('rotating');
                    });
                } else {
                    bgMusic.pause();
                    musicIcon.classList.remove('rotating');
                }
            }
        }

        // Countdown Timer Logic
        function startCountdown() {
            const weddingDate = new Date('2026-12-13T09:00:00').getTime();

            const timer = setInterval(() => {
                const now = new Date().getTime();
                const distance = weddingDate - now;

                if (distance < 0) {
                    clearInterval(timer);
                    document.getElementById('cd-days').innerText = '00';
                    document.getElementById('cd-hours').innerText = '00';
                    document.getElementById('cd-minutes').innerText = '00';
                    document.getElementById('cd-seconds').innerText = '00';
                    return;
                }

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                document.getElementById('cd-days').innerText = String(days).padStart(2, '0');
                document.getElementById('cd-hours').innerText = String(hours).padStart(2, '0');
                document.getElementById('cd-minutes').innerText = String(minutes).padStart(2, '0');
                document.getElementById('cd-seconds').innerText = String(seconds).padStart(2, '0');
            }, 1000);
        }

        // Handle RSVP Submission
        function handleRSVP(e) {
            e.preventDefault();
            
            const name = document.getElementById('guest-input-name').value;
            const status = document.getElementById('attendance-status').value;
            const wish = document.getElementById('wish-message').value;

            if (!name || !status || !wish) return;

            const container = document.getElementById('wishes-container');
            const wishCountElem = document.getElementById('wish-count');
            let currentCount = parseInt(wishCountElem.innerText) || 0;

            // Create new wish element dynamically
            const newWish = document.createElement('div');
            newWish.className = 'glass-card p-4 rounded-2xl border-l-4 border-sage-500 transition-all duration-500';
            
            const badgeColor = status === 'Hadir' ? 'bg-sage-200 text-sage-800' : (status === 'Ragu-ragu' ? 'bg-amber-100 text-amber-800' : 'bg-red-100 text-red-800');

            newWish.innerHTML = `
                <div class="flex justify-between items-center mb-1">
                    <h4 class="font-semibold text-sm text-sage-900">${escapeHtml(name)}</h4>
                    <span class="text-[10px] ${badgeColor} px-2 py-0.5 rounded-full font-medium">${status}</span>
                </div>
                <p class="text-xs text-sage-700 mt-2">${escapeHtml(wish)}</p>
                <span class="text-[10px] text-sage-400 block mt-2">Baru saja</span>
            `;

            container.insertBefore(newWish, container.firstChild);
            wishCountElem.innerText = currentCount + 1;

            // Clear form inputs
            document.getElementById('rsvp-form').reset();

            // Custom Notification Toast Message
            alertCustom(`Terima kasih ${name}, konfirmasi dan ucapan Anda berhasil terkirim!`);
        }

        // Gallery Modal Lightbox Preview
        function openModal(src) {
            const modal = document.getElementById('image-modal');
            const modalImg = document.getElementById('modal-img');
            modalImg.src = src;
            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('image-modal').classList.add('hidden');
        }

        // Sanitize Input HTML
        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        // Custom Notification Toast
        function alertCustom(msg) {
            const toast = document.createElement('div');
            toast.className = 'fixed top-6 left-1/2 transform -translate-x-1/2 bg-sage-800 text-cream px-6 py-3 rounded-full shadow-2xl text-xs z-50 transition-all duration-500 opacity-0';
            toast.innerText = msg;
            document.body.appendChild(toast);

            setTimeout(() => toast.classList.remove('opacity-0'), 100);
            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 500);
            }, 3500);
        }
    </script>
